\input{regression-test}
\DocumentMetadata{tagging=on}
\documentclass[a4paper, \classoptions]{article}
\usepackage{pdfpages}

\begin{document}
\START\showoutput

% page  alt text
% ----  --------
%  1    --default--
%  2    --artifact--
\verboseTEST{Default alt text}{
  \includepdf[
    pages = 1-2,
  ]{dummy.pdf}
}

% page  alt text
% ----  --------
%  1    lorem ipsum
%  2    --artifact--
\verboseTEST{User alt text}{
  \includepdf[
    pages = 1-2,
    alt = {lorem ipsum}
  ]{dummy.pdf}
}

% page  alt text
% ----  --------
%  1    This is dummy.pdf, page 1
%  2    --artifact--
\verboseTEST{}{
  \includepdf[
    pages = 1-2,
    alt = {This is \FileName, page \PageNum}
  ]{dummy.pdf}
}

% page  alt text
% ----  --------
%  1    --artifact--
%  2    --artifact--
\verboseTEST{All pages artifacts}{
  \includepdf[
    pages = 1-2,
    artifact
  ]{dummy.pdf}
}

% page  alt text
% ----  --------
%  1    --artifact--
%  2    --artifact--
\verboseTEST{All pages artifacts}{
  \includepdf[
    pages = 1-2,
    alt = \Artifact
  ]{dummy.pdf}
}

\end{document}
